# PostgreSQL (matches docker-compose.yml — bind 127.0.0.1 only)
DATABASE_URL=postgresql://contactvault:contactvault@localhost:5432/contactvault

# development | test | production
NODE_ENV=development

# KD14: when true, store raw report bodies under data/reports/{id}.bin (gitignored).
# Default false — hash + metadata only (PII minimization).
# STORE_RAW_REPORTS=false
#
# Optional 32-byte AES-256 key (64 hex chars).
# - STORE_RAW_REPORTS=true: write an AES-256-GCM envelope to data/reports/{id}.bin
# - Always: when set, seal IdentityDocument.number and store HMAC(numberNorm)
#   so exact match + list search of a full normalized number still work.
# Unset key keeps plaintext files and plaintext number/numberNorm (residual risk).
# Never commit or log this value. contentHash stays SHA-256 of plaintext.
#   openssl rand -hex 32
# REPORT_BLOB_KEY=

# Public app URL (optional; UI deep-links)
# NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
