{
  "name": "contact-vault",
  "private": true,
  "version": "0.1.1",
  "description": "Contact management platform with OSINT report ingestion (void-html, sectioned-text, inline-dossier)",
  "scripts": {
    "dev": "turbo run dev --filter=@contact-vault/web",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @contact-vault/db db:generate",
    "db:migrate": "pnpm --filter @contact-vault/db db:migrate",
    "db:migrate:deploy": "pnpm --filter @contact-vault/db db:migrate:deploy",
    "db:studio": "pnpm --filter @contact-vault/db db:studio",
    "smoke": "tsx scripts/smoke-import.ts",
    "check:fixtures": "tsx scripts/check-fixtures.ts"
  },
  "devDependencies": {
    "@contact-vault/db": "workspace:*",
    "@contact-vault/domain": "workspace:*",
    "@contact-vault/parser": "workspace:*",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
